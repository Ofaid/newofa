<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ✅ DAFTAR CHANNEL — DI BAWAH, TETAP DIAM! -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channelUsers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="0dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="true"
        android:choiceMode="singleChoice"
        android:clipToPadding="false"/>

    <!-- ✅ BARIS ATAS: TOMBOL KIRI + VISUALIZER + TOMBOL KANAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp">

      <!-- 🔘 TOMBOL KIRI → IKON DARI PROYEKMU SENDIRI -->
 <ImageButton
     android:id="@+id/btnKiri"
     android:layout_width="40dp"
     android:layout_height="40dp"
     android:background="@drawable/bg_tombol_biru"
     android:src="@drawable/ic_action_microphone"
android:tint="#FFFFFF"
     android:contentDescription="Mikrofon" />
        <!-- 📊 VISUALIZER DI TENGAH -->
     <ofaid.ahmad.ptt.channel.NeonVisualizerView
    android:id="@+id/neonVisualizer"
    android:layout_width="match_parent"
    android:layout_height="30dp" />

        <!-- 🔘 TOMBOL KANAN -->
        <ImageButton
            android:id="@+id/btnKanan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tombol_biru"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#FFFFFF"
            android:contentDescription="Pengaturan" />

    </LinearLayout>

    <!-- ✅ BANNER NAMA — DI BAWAH BARIS ATAS -->
    <FrameLayout
        android:id="@+id/bannerActiveSpeaker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:background="#D32F2F"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSpeakerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:drawablePadding="8dp"
            android:gravity="center_vertical" />

    </FrameLayout>

</FrameLayout>