<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ✅ DAFTAR CHANNEL — TETAP UTUH -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channelUsers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="0dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="true"
        android:choiceMode="singleChoice"
        android:clipToPadding="false"/>

    <!-- ✅ BARIS ATAS: TOMBOL + VISUALIZERS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp">

        <!-- 🔘 TOMBOL KIRI -->
        <ImageButton
            android:id="@+id/btnKiri"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tombol_biru"
            android:src="@drawable/ic_action_microphone"
           android:visibility="gone"
            android:tint="#FFFFFF"
            android:contentDescription="Mikrofon" />

        <!-- 📊 NEON VISUALIZER (MIC) → TETAP ADA -->
        <ofaid.ahmad.ptt.ofa.NeonVisualizerView
            android:id="@+id/neonVisualizer"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"/>

        <!-- 📊 MONITOR VISUALIZER → YANG BARU JALAN -->
        <ofaid.ahmad.ptt.ofa.VisualizerView
            android:id="@+id/visualizerMonitor"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"/>

        <!-- 🔘 TOMBOL KANAN -->
        <ImageButton
            android:id="@+id/btnKanan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tombol_biru"
           android:visibility="gone"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#FFFFFF"
            android:contentDescription="Pengaturan" />

    </LinearLayout>
<FrameLayout
    android:id="@+id/bannerActiveSpeaker"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_marginTop="52dp"
    android:background="#212B64"
    android:padding="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgSpeakerAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSpeakerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpeakerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>


</FrameLayout>
