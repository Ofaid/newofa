<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channelcontainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/channel_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.viewpager.widget.PagerTabStrip
            android:id="@+id/channel_tab_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"/>
    </androidx.viewpager.widget.ViewPager>

    <FrameLayout
        android:id="@+id/target_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorPrimaryDark">

        <TextView
            android:id="@+id/target_panel_warning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Shouting to Channel"
            android:textSize="6pt"
            android:textColor="?android:textColorPrimaryInverse"
            android:singleLine="true"
            android:gravity="left|center_vertical"
            android:textStyle="italic"
            android:padding="8dp"/>

        <ImageView
            android:id="@+id/target_panel_cancel"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_action_delete_dark"
            android:tint="?android:textColorPrimaryInverse"
            android:layout_gravity="center_vertical|end"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </FrameLayout>

    <!-- ============================================================= -->
    <!-- ✅ TOMBOL PILIH AVATAR — DITAMBAHKAN DI SINI, DI ATAS PTT -->
    <!-- ============================================================= -->
    <Button
        android:id="@+id/tombol_pilih_avatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Foto Profile"
        android:textColor="?android:attr/textColorPrimaryInverse"
        android:textAllCaps="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:backgroundTint="@color/colorAccent" />
    <!-- ============================================================= -->

    <LinearLayout
        android:id="@+id/pushtotalk_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

  <!-- TOMBOL PUSH-TO-TALK — SAMA CANTIK DENGAN TOMBOL AVATAR ✅ -->
<Button
    android:id="@+id/pushtotalk"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:text="TEKAN UNTUK BICARA"
    android:textSize="17sp"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    android:backgroundTint="#3B82F6"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:stateListAnimator="@null"
    app:cornerRadius="14dp"
    android:elevation="3dp"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="16dp" />

    </LinearLayout>
<!-- Visualizer Gelombang Suara -->
<LinearLayout
    android:id="@+id/visualizerContainer"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_margin="8dp"
    android:background="#1AFFFFFF">

    <!-- Untuk Pengirim (Kamu) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="🎤"
        android:gravity="center"
        android:padding="4dp"/>

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/visSender"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"/>

    <!-- Untuk Penerima (Mereka) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="👂"
        android:gravity="center"
        android:padding="4dp"/>

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/visReceiver"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"/>
</LinearLayout>


</LinearLayout>
